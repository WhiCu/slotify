{
  "uid": "slotify-app",
  "title": "Slotify - Application Metrics",
  "tags": [
    "slotify",
    "red",
    "use",
    "golden-signals"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Golden Signals \u0026 SLO (окна 24h)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(ogen_server_request_count_total{http_response_status_code!~\"5..\"}[24h])) / sum(rate(ogen_server_request_count_total[24h]))",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ],
      "title": "API Availability (SLI-1)",
      "description": "Golden Signals / Errors: доля запросов без 5xx за 24 ч. SLO 99.5% (бюджет ошибок 0.5%); ниже 99% - жёлтая зона, ниже 99.5% - SLO нарушен.",
      "transparent": false,
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ]
        },
        "minVizHeight": 75,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.99,
                "color": "yellow"
              },
              {
                "value": 0.995,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(ogen_server_duration_milliseconds_bucket{le=\"750\"}[24h])) / sum(rate(ogen_server_duration_milliseconds_count[24h]))",
          "legendFormat": "Fast requests",
          "refId": "A"
        }
      ],
      "title": "Latency SLO (\u003c= 750 ms)",
      "description": "Golden Signals / Latency: доля запросов, обработанных быстрее 750 мс, за 24 ч. SLO 95% - цель из отчёта; красный - цель не выполняется.",
      "transparent": false,
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ]
        },
        "minVizHeight": 75,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.95,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "max(pg_up)",
          "legendFormat": "Postgres",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL Up",
      "description": "Golden Signals / Saturation: жива ли база (pg_up из postgres-экспортера). SLO хранилища: доступность \u003e= 99.5% времени. No data = экспортер молчит.",
      "transparent": false,
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background_solid",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
