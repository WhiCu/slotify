          }
        },
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
      "targets": [
        {
          "expr": "max(max_over_time({__name__=\"httpcheck.status\", http.status_class=\"2xx\"}[1m]))",
          "legendFormat": "/healthz",
          "refId": "A"
