                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Health Probe /healthz (OTel httpcheck) - SLA пробера",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "sum(sum_over_time({__name__=\"httpcheck.status\", http.status_class=\"2xx\"}[24h])) / sum(count_over_time({__name__=\"httpcheck.status\", http.status_class=\"2xx\"}[24h]))",
          "legendFormat": "Probe SLA",
          "refId": "A"
        }
      ],
      "title": "Probe SLA /healthz (24h)",
      "description": "Подсчёт SLA пробера: доля успешных проверок /healthz за 24 ч = сумма значений точек класса 2xx / общее число точек (одна точка на каждую проверку, включая сетевые провалы без http.status_code).",
      "transparent": false,
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 10
      },
